# Neon Postgres (Vercel → Storage → Neon fills this in automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel AI Gateway — the only LLM provider for hints
# (Dashboard → AI Gateway → API Keys; the $5/mo free credits are enough).
# Optional on Vercel deploys: the AI SDK picks up VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
# Gateway model (catalog: https://vercel.com/ai-gateway/models)
# AI_GATEWAY_MODEL=xai/grok-4.1-fast-non-reasoning

# Kill switch: false => the app runs on the static phrase catalog only
HINTS_ENABLED=true
# Hint pool regeneration period, minutes
HINTS_TTL_MINUTES=60

# Telegram notifications. All four are optional:
# without TELEGRAM_BOT_TOKEN the whole subsystem is off.
# Bot token — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Webhook secret (generate: openssl rand -hex 16). Register with:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=
# Protects /api/cron/notify (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Optional deployment-wide access PIN. When set, every page and API request
# requires unlocking once via /pin (httpOnly cookie, ~1 year). Empty/unset —
# open access as before. Changing the value logs every device out.
ACCESS_PIN=
# Kill switch: false => the bot stays silent, the link panel is hidden
TELEGRAM_ENABLED=true

NEXT_PUBLIC_APP_NAME=TeamWalk
TZ=Europe/Moscow

# UI language (hints and the Telegram bot too): en | ru | es. Defaults to en.
# The variable is inlined into the client bundle at build time — changing it requires a redeploy.
NEXT_PUBLIC_LOCALE=en
