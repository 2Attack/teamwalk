# Neon Postgres (Vercel → Storage → Neon подставляет автоматически)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Google AI Studio — основной провайдер хинтов (карта не требуется)
GEMINI_API_KEY=
# Groq — резервный провайдер (опционально)
GROQ_API_KEY=

# Рубильник: false => приложение работает только на статическом каталоге фраз
HINTS_ENABLED=true
# Период регенерации пула хинтов, минуты
HINTS_TTL_MINUTES=60

NEXT_PUBLIC_APP_NAME=CitrusWalk
TZ=Europe/Moscow
