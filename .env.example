# Neon Postgres (Vercel → Storage → Neon подставляет автоматически)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel AI Gateway — единственный LLM-провайдер хинтов
# (Dashboard → AI Gateway → API Keys; $5/мес бесплатных кредитов хватает).
# На деплоях Vercel можно не задавать: AI SDK возьмёт VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
# Модель Gateway (каталог: https://vercel.com/ai-gateway/models)
# AI_GATEWAY_MODEL=xai/grok-4.1-fast-non-reasoning

# Рубильник: false => приложение работает только на статическом каталоге фраз
HINTS_ENABLED=true
# Период регенерации пула хинтов, минуты
HINTS_TTL_MINUTES=60

# Telegram-уведомления (п. 6.10 ТЗ). Все четыре опциональны:
# без TELEGRAM_BOT_TOKEN подсистема выключена целиком.
# Токен бота — @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Секрет webhook (сгенерировать: openssl rand -hex 16). Регистрация:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<домен>/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=
# Защита /api/cron/notify (Vercel сам шлёт Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Рубильник: false => бот молчит, панель привязки не показывается
TELEGRAM_ENABLED=true

NEXT_PUBLIC_APP_NAME=TeamWalk
TZ=Europe/Moscow
